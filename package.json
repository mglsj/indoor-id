{
	"name": "indoor-id",
	"version": "0.1.0-alpha",
	"description": "Web tool for editing OpenStreetMap building indoors data",
	"private": true,
	"type": "module",
	"license": "ISC",
	"author": "mglsj",
	"repository": {
		"type": "git",
		"url": "https://github.com/mglsj/indoor-id.git"
	},
	"keywords": [
		"openstreetmap",
		"indoor",
		"editor",
		"osm",
		"building"
	],
	"engines": {
		"node": ">=22.17"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "bun scripts/build-presets.ts && bun run messages && (svelte-kit sync || echo '')",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"lint": "biome check .",
		"format": "biome check --write .",
		"test": "bun run test:unit && bun run test:e2e",
		"test:unit": "vitest run",
		"test:e2e": "playwright test",
		"presets": "bun scripts/build-presets.ts",
		"messages": "paraglide-js compile --project ./project.inlang --outdir ./src/lib/i18n/paraglide --strategy localStorage preferredLanguage baseLocale --output-structure locale-modules --no-emit-readme --no-emit-prettier-ignore --silent",
		"bench": "bun scripts/bench-core.ts"
	},
	"imports": {
		"#lib/*": "./src/lib/*"
	},
	"devDependencies": {
		"@biomejs/biome": "2.6.9",
		"@enzet/roentgen": "0.16.0",
		"@fontsource-variable/inter": "^5.3.0",
		"@fortawesome/free-regular-svg-icons": "7.3.1",
		"@fortawesome/free-solid-svg-icons": "7.3.1",
		"@inlang/paraglide-js": "3.2.2",
		"@mapbox/maki": "8.2.0",
		"@maplibre/maplibre-gl-style-spec": "26.9.0",
		"@openstreetmap/id-tagging-schema": "7.3.0",
		"@playwright/test": "1.63.0",
		"@rapideditor/temaki": "5.13.0",
		"@sveltejs/adapter-static": "4.0.1",
		"@sveltejs/kit": "3.4.0",
		"@sveltejs/vite-plugin-svelte": "7.3.2",
		"@tailwindcss/vite": "4.3.5",
		"@types/node": "26.6.10",
		"@types/polylabel": "^2.0.0",
		"@types/rbush": "4.0.0",
		"@vitest/browser-playwright": "5.1.2",
		"@waysidemapping/pinhead": "16.26.0",
		"fake-indexeddb": "6.2.8",
		"playwright": "1.63.0",
		"shadcn-svelte": "^1.8.2",
		"svelte": "5.59.1",
		"svelte-check": "4.7.8",
		"tailwindcss": "4.3.5",
		"tw-animate-css": "^1.4.0",
		"typescript": "6.0.3",
		"vite": "8.3.8",
		"vitest": "5.1.2",
		"vitest-browser-svelte": "3.1.0"
	},
	"dependencies": {
		"@internationalized/date": "^3.12.0",
		"@jsquash/jxl": "1.3.0",
		"@lucide/svelte": "^1.80.0",
		"bits-ui": "2.22.0",
		"clipper2-ts": "2.0.1-19",
		"cn": "^0.5.2",
		"earcut": "3.2.4",
		"fflate": "0.8.3",
		"idb": "8.0.4",
		"immutable": "5.2.1",
		"maplibre-gl": "6.19.0",
		"mode-watcher": "^1.1.0",
		"osm-auth": "3.2.0",
		"pdfjs-dist": "6.5.438",
		"polyclip-ts": "0.16.8",
		"polylabel": "2.1.0",
		"rbush": "4.0.1",
		"tailwind-variants": "^3.3.1",
		"wmf-sitematrix": "0.2.0"
	},
	"packageManager": "bun@1.4.4"
}
