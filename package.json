{
	"name": "indoor-id",
	"version": "0.0.1",
	"description": "Web tool for editing OpenStreetMap building indoors data",
	"private": true,
	"type": "module",
	"license": "MIT",
	"author": "mglsj",
	"repository": {
		"type": "git",
		"url": "https://github.com/mglsj/indoor-id.git"
	},
	"keywords": [
		"openstreetmap",
		"indoor",
		"editor",
		"osm",
		"building"
	],
	"engines": {
		"node": ">=22.17"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "bun scripts/build-presets.ts && bun scripts/build-messages.ts && (svelte-kit sync || echo '')",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"lint": "biome check .",
		"format": "biome check --write .",
		"test": "bun run test:unit && bun run test:e2e",
		"test:unit": "vitest run",
		"test:e2e": "playwright test",
		"presets": "bun scripts/build-presets.ts",
		"messages": "bun scripts/build-messages.ts",
		"bench": "bun scripts/bench-core.ts"
	},
	"imports": {
		"#lib/*": "./src/lib/*"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.15",
		"@fontsource-variable/inter": "^5.3.0",
		"@internationalized/date": "^3.12.0",
		"@mapbox/maki": "8.2.0",
		"@maplibre/maplibre-gl-style-spec": "26.4.4",
		"@openstreetmap/id-tagging-schema": "7.3.0",
		"@playwright/test": "1.56.1",
		"@rapideditor/temaki": "5.13.0",
		"@sveltejs/adapter-static": "4.0.0",
		"@sveltejs/kit": "3.0.1",
		"@sveltejs/vite-plugin-svelte": "7.3.1",
		"@tailwindcss/vite": "4.3.3",
		"@types/node": "26.6.5",
		"@types/rbush": "4.0.0",
		"@vitest/browser-playwright": "5.0.4",
		"cn": "^0.3.0",
		"fake-indexeddb": "6.2.5",
		"mode-watcher": "^1.1.0",
		"osm-auth": "3.2.0",
		"playwright": "1.56.1",
		"rbush": "4.0.1",
		"shadcn-svelte": "^1.7.0",
		"svelte": "5.57.2",
		"svelte-check": "4.7.6",
		"tailwind-variants": "^3.3.1",
		"tailwindcss": "4.3.3",
		"tw-animate-css": "^1.4.0",
		"typescript": "6.0.3",
		"vite": "8.3.4",
		"vitest": "5.0.4",
		"vitest-browser-svelte": "3.1.0"
	},
	"dependencies": {
		"@jsquash/jxl": "1.3.0",
		"@lucide/svelte": "^1.57.0",
		"bits-ui": "2.19.5",
		"earcut": "3.2.4",
		"fflate": "0.8.3",
		"idb": "8.0.4",
		"immutable": "5.1.9",
		"maplibre-gl": "6.14.0",
		"pdfjs-dist": "6.4.299",
		"wmf-sitematrix": "0.2.0"
	},
	"packageManager": "bun@1.4.2"
}
